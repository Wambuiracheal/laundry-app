# PostgreSQL. Locally: the docker-compose postgres service (same value for both).
# On Supabase (Project > Connect):
#   DATABASE_URL = Transaction pooler, port 6543, with ?pgbouncer=true&connection_limit=1 appended
#   DIRECT_URL   = Session pooler, port 5432 (used by `prisma migrate deploy`)
DATABASE_URL="postgresql://laundry_user:laundry_pass@localhost:5432/laundry_db"
DIRECT_URL="postgresql://laundry_user:laundry_pass@localhost:5432/laundry_db"
BE_PORT=5000
SESSION_SECRET="246ee396d01ddb86a39b4840580f369f453abef51da22c9de802176aeac3f794a4381af8e5c0d604cb6c263ec4e10d13ca866e2c614f9caf9aa9834bdad7fff8"

# Production only. development | production
NODE_ENV=development
# Origins allowed to call the API, comma-separated (e.g. https://your-site.netlify.app). Unset = any.
CLIENT_URL=
# Random string, 32+ chars; keeps users signed in across restarts. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SIGNING_SEED=

# Optional Redis (caching and event publishing): use REDIS_URL or REDIS_HOST + REDIS_PORT.
# Leave unset to run without it.
REDIS_URL="redis://localhost:6379"
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Firebase Storage for damage photos (Project settings > Service accounts > Generate new private key).
# Leave these empty to run without photo uploads; damage notes still work.
# Keep the private key on one line with literal \n sequences, wrapped in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# e.g. your-project.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# M-Pesa Express (STK push) via Safaricom Daraja. Get keys from developer.safaricom.co.ke > My Apps.
# sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox test paybill is 174379 with Safaricom's published sandbox passkey.
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
# Optional: public HTTPS origin Daraja can reach (production domain or a tunnel such as ngrok)
# plus a long random secret used in the callback path. Without them, payments are confirmed
# by querying Daraja, and M-Pesa receipt numbers are not captured.
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_SECRET=

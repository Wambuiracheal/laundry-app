// This is your Prisma schema file

// PostgreSQL (Supabase in production, the postgres container locally).
// DATABASE_URL: what the app queries through. On Supabase, the transaction pooler (port 6543,
// with ?pgbouncer=true). DIRECT_URL: used by `prisma migrate`, which needs a session connection.
// On Supabase, the session pooler (port 5432). Locally both point at the same database.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}


model User {
  id            String         @id @default(uuid())
  first_name    String
  last_name     String
  // Supabase Auth user id (auth.users.id). Sign-in, passwords and social logins live in Supabase;
  // this table holds the profile and the role, which only the backend can change.
  auth_id       String?        @unique
  email         String         @unique
  phone         String
  password_hash String?        // legacy: kept only for accounts not yet moved to Supabase
  role          String         // customer | admin | rider | staff
  sms_opt_in    Boolean        @default(true) // customers: text me when my order moves
  orders        Order[]        @relation("UserOrders")
  reviews       Review[]
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  assignedOrders Order[]       @relation("AssignedRiderOrders")
  earnings      RiderEarning[] @relation("RiderEarnings")
  location      RiderLocation?
  notifications Notification[]
}

// An update about a customer's order: listed in the app and, when the customer has SMS on,
// texted to their phone.
model Notification {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id])
  order_id   String?
  order      Order?    @relation(fields: [order_id], references: [id])
  event      String    // order_placed | rescheduled | picked_up | processing | ready | out_for_delivery | delivered | cancelled | payment_received
  message    String    @db.Text
  sms_status String    // sent | failed | skipped (SMS off, not configured, or no valid phone)
  sms_error  String?
  read_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, created_at])
}


model Service {
  id          String      @id @default(uuid())
  name        String
  description String?
  price_type  String?     // per_kg | per_item | fixed
  base_price  Decimal?
  orderItems  OrderItem[]
  created_at  DateTime    @default(now())
}


model Order {
  id                String      @id @default(uuid())
  user_id           String
  user              User        @relation("UserOrders", fields: [user_id], references: [id])
  pickup_address    String
  pickup_lat        Float?
  pickup_lng        Float?
  pickup_time       DateTime?
  delivery_time     DateTime?
  status            String      // pending_pickup | picked_up | processing | ready | out_for_delivery | delivered | cancelled
  notes             String?     @db.Text
  house_details     String?     // house/apartment/gate number
  delivery_instructions String? @db.Text // directions for the rider (landmarks, what to tell the guard)
  // Pickup + delivery fee charged to the customer and paid on to riders: two trips of
  // (shop <-> customer km x rate), fixed when quoted so customer and riders see the same numbers.
  delivery_distance_km     Decimal? @db.Decimal(8, 2) // one way
  delivery_distance_source String?  // road | straight_line | manual
  delivery_rate_per_km     Decimal? @db.Decimal(10, 2)
  delivery_fee             Decimal? @db.Decimal(10, 2) // both trips; null until the distance is known
  deposit_amount    Decimal?
  total_amount      Decimal?
  remaining_amount  Decimal?
  payment_status    String      // pending | partial | paid
  assigned_rider_id String?
  assignedRider     User?       @relation("AssignedRiderOrders", fields: [assigned_rider_id], references: [id])
  orderItems        OrderItem[]
  payments          Payment[]
  statusHistory     OrderStatusHistory[]
  damages           DamageReport[]
  riderEarnings     RiderEarning[]
  reviews           Review[]
  notifications     Notification[]
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
}


model OrderItem {
  id         String   @id @default(uuid())
  order_id   String
  order      Order    @relation(fields: [order_id], references: [id])
  service_id String
  service    Service  @relation(fields: [service_id], references: [id])
  quantity   Int      @default(1)
  weight_kg  Decimal? // per-kg services: set when the shop weighs the clothes
  price      Decimal? // null until the shop has weighed/counted the items
  damages    DamageReport[]
}

// What a rider earns for one trip: the pickup (customer -> shop) or the delivery (shop -> customer).
// Each trip is paid to whoever did it, at the per-km rate in force at the time.
model RiderEarning {
  id              String    @id @default(uuid())
  rider_id        String
  rider           User      @relation("RiderEarnings", fields: [rider_id], references: [id])
  order_id        String
  order           Order     @relation(fields: [order_id], references: [id])
  leg             String    // pickup | delivery
  distance_km     Decimal?  @db.Decimal(8, 2)
  distance_source String?   // road | straight_line | manual
  rate_per_km     Decimal   @db.Decimal(10, 2)
  amount          Decimal?  @db.Decimal(10, 2)
  status          String    // needs_distance | unpaid | paid
  paid_at         DateTime?
  created_at      DateTime  @default(now())

  @@unique([order_id, leg])
}

// A rider's latest GPS position, shared from the rider app while they have active jobs.
// One row per rider, overwritten on every update; not a location history.
model RiderLocation {
  rider_id   String   @id
  rider      User     @relation(fields: [rider_id], references: [id])
  lat        Float
  lng        Float
  accuracy_m Float?
  heading    Float?
  updated_at DateTime @default(now()) @updatedAt
}

// Admin-editable settings (rider rate per km, shop location), stored as strings.
model Setting {
  key        String   @id
  value      String
  updated_at DateTime @default(now()) @updatedAt
}

// Pre-existing damage (stains, tears) logged at intake, before washing.
model DamageReport {
  id            String     @id @default(uuid())
  order_id      String
  order         Order      @relation(fields: [order_id], references: [id])
  order_item_id String?
  orderItem     OrderItem? @relation(fields: [order_item_id], references: [id])
  note          String     @db.Text
  photo_path    String?    // object path in the Firebase Storage bucket
  created_by    String     // user id of the staff member who logged it
  created_at    DateTime   @default(now())
}

model Payment {
  id             String   @id @default(uuid())
  order_id       String
  order          Order    @relation(fields: [order_id], references: [id])
  amount         Decimal
  payment_method String   // mpesa | card | cash
  transaction_id String?
  status         String   // pending | success | failed
  // M-Pesa STK push details
  phone               String?   // 2547XXXXXXXX the prompt was sent to
  checkout_request_id String?   @unique
  merchant_request_id String?
  mpesa_receipt       String?   // e.g. "SJK4XXXXXX", only known from the Daraja callback
  result_code         String?
  result_desc         String?
  last_queried_at     DateTime? // throttles STK status queries to Daraja
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt
  transaction    Transaction?
}

model Transaction {
  id             String   @id @default(uuid())
  payment_id     String?  @unique
  payment        Payment? @relation(fields: [payment_id], references: [id])
  mpesa_ref_no   String?
  amount         Decimal
  type           String   // credit | debit
}

model OrderStatusHistory {
  id         String   @id @default(uuid())
  order_id   String
  order      Order    @relation(fields: [order_id], references: [id])
  status     String
  changed_by String   // admin/rider
  timestamp  DateTime @default(now())
}

model Review {
  id         String   @id @default(uuid())
  order_id   String
  order      Order    @relation(fields: [order_id], references: [id])
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  rating     Int
  comment    String?
  created_at DateTime @default(now())
}

model SupportTicket {
  id         String   @id @default(uuid())
  full_name  String
  email      String
  order_ref  String?
  message    String
  status     String   @default("received")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// No longer written (password resets moved to Supabase Auth; reschedules change the order itself).
// Kept so existing rows aren't lost; drop with a migration once they're not needed.
model PasswordResetRequest {
  id         String   @id @default(uuid())
  email      String
  status     String   @default("accepted")
  created_at DateTime @default(now())
}

// No longer written (password resets moved to Supabase Auth; reschedules change the order itself).
// Kept so existing rows aren't lost; drop with a migration once they're not needed.
model PickupRescheduleRequest {
  id          String   @id @default(uuid())
  pickup_date DateTime
  time_window String
  note        String?
  status      String   @default("updated")
  created_at  DateTime @default(now())
}

model CancellationRequest {
  id           String   @id @default(uuid())
  request_type String   // pickup | order
  reason       String
  details      String
  acknowledged Boolean  @default(false)
  status       String   @default("received")
  created_at   DateTime @default(now())
}
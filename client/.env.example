# Copy to .env.local for local development. NEXT_PUBLIC_* values are baked in at build time.

# The API (the server container locally, the Render URL in production).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Supabase Auth: Project settings > API. The anon / publishable key is safe in the browser;
# never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
